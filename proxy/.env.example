# ═══════════════════════════════════════════════════════════════
# DeepClaude — Provider Configuration
# ═══════════════════════════════════════════════════════════════
# Set API_PROVIDER to the provider you want to use.
# Just edit this file and run: ./deepclaude.sh
# No need for -b flag — it reads from here automatically.
#
# Supported providers: doubleword, nvidia, kimi, moonshot, deepseek
# ═══════════════════════════════════════════════════════════════

 API_PROVIDER=doubleword
#  API_PROVIDER=kimi

# ───────────────────────────────────────────────────────────────
# DoubleWord AI  (OpenAI-compatible)
# URL: https://api.doubleword.ai/v1
# ───────────────────────────────────────────────────────────────
DOUBLEWORD_API_KEY=your_api_key
DOUBLEWORD_MODEL=deepseek-ai/DeepSeek-V4-Pro #Default is DeepSeek-V4-Pro, but you can also use other models from https://www.doubleword.ai/models

# ───────────────────────────────────────────────────────────────
# NVIDIA NIM  (OpenAI-compatible)
# URL: https://integrate.api.nvidia.com/v1
# ───────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your_api_key
NVIDIA_MODEL=moonshotai/kimi-k2.6 #Default is moonshotai/kimi-k2.6, but you can also use other models from https://integrate.api.nvidia.com/v1/models

# ───────────────────────────────────────────────────────────────
# Kimi Code  (Native Anthropic format — NO translation needed!)
# URL: https://api.kimi.com/coding/
# API Key from: https://www.kimi.com/code/console
# Model: auto (always uses latest Kimi model)
# Docs: https://www.kimi.com/code/docs/en/third-party-tools/other-coding-agents.html
# ───────────────────────────────────────────────────────────────
KIMI_API_KEY=your_api_key
KIMI_MODEL=kimi-for-coding #Default is kimi-for-coding, but you can also use other models from https://api.kimi.com/coding/models

# ───────────────────────────────────────────────────────────────
# Moonshot Platform  (OpenAI-compatible, pay-per-token)
# URL: https://api.moonshot.ai/v1
# API Key from: https://platform.kimi.ai/console/api-keys
# ───────────────────────────────────────────────────────────────
MOONSHOT_API_KEY=your_api_key
MOONSHOT_MODEL=kimi-k2.6 #Default is kimi-k2.6, but you can also use other models from https://api.moonshot.ai/v1/models

# ───────────────────────────────────────────────────────────────
# DeepSeek  (Native Anthropic format — no translation needed)
# URL: https://api.deepseek.com/anthropic
# ───────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_MODEL=deepseek-v4-pro #Default is deepseek-v4-pro, but you can also use other models from https://api.deepseek.com/anthropic/models



# ───────────────────────────────────────────────────────────────
# Kiro  (AWS Claude via kirocc gateway — Anthropic-native)
# Uses kirocc gateway: https://github.com/d-kuro/kirocc
# Auth: Kiro CLI credentials (auto-read from SQLite DB)
# Models: claude-sonnet-4-6, claude-opus-4.6, claude-haiku-4.5 (mapped by kirocc)
# ───────────────────────────────────────────────────────────────
KIRO_API_KEY=
KIRO_MODEL=claude-sonnet-4.6 #Default is claude-sonnet-4.6 (Pro plan). Available: claude-sonnet-4.6, claude-sonnet-4.5, claude-haiku-4.5, claude-opus-4.6 (use dot notation!)
# use claude sonnet 4.5 is not pro plan 